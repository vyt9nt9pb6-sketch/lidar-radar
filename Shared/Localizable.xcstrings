      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The distance shader is missing. Make sure DepthReduction.metal is in the app target."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到距離計算著色器。請確認 DepthReduction.metal 有加入主 App target。"
          }
