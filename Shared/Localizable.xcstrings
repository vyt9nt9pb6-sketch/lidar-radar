{
  "sourceLanguage": "en",
  "strings": {
    "app.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forward Radar"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前方雷達"
          }
        }
      }
    },
    "checking.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking this iPhone"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在確認這支 iPhone"
          }
        }
      }
    },
    "consent.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you look down, LiDAR measures what is ahead. After monitoring starts, you don't need to tap."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "低頭走路時，用光達看前方還有多遠。監測開始之後不用再點畫面。"
          }
        }
      }
    },
    "consent.principles": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three principles"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "三個原則"
          }
        }
      }
    },
    "consent.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a medical or accessibility guarantee. Glass, dark clothing, speed, and the phone's angle can make LiDAR wrong, so still watch where you walk. When the phone locks or you switch to another app, iOS turns the camera off and the Live Activity shows Paused."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是醫療或無障礙保證。玻璃、黑衣、速度和手機角度都會讓光達失準，請仍要看路。手機鎖定或切到別的 App 時，iOS 會關掉相機，即時動態會改顯示「已暫停」。"
          }
        }
      }
    },
    "consent.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have read this and I agree"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我已閱讀，並同意以上內容"
          }
        }
      }
    },
    "consent.agree": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agree and start monitoring"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同意並開始監測"
          }
        }
      }
    },
    "consent.later": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If not now, leave the app here. The camera stays off until you agree."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先不要的話，把這個 App 留在這裡即可。不同意就不會使用相機。"
          }
        }
      }
    },
    "principle.local.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processed on this iPhone"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在手機上處理"
          }
        }
      }
    },
    "principle.local.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiDAR depth is turned into a distance on this phone, then discarded."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "光達深度只在這支手機裡換算成前方距離，算完就丟。"
          }
        }
      }
    },
    "principle.upload.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never uploaded"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從不上傳"
          }
        }
      }
    },
    "principle.upload.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no account and no server. Nothing leaves this phone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有帳號，也沒有伺服器。資料不會離開這支手機。"
          }
        }
      }
    },
    "principle.store.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never stored"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從不儲存"
          }
        }
      }
    },
    "principle.store.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance and camera frames are not written to a file. This phone only remembers your consent and settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "距離與相機畫面不會寫進檔案。本機只記住你的同意和設定開關。"
          }
        }
      }
    },
    "permission.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is required to see ahead"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要相機才能看前方"
          }
        }
      }
    },
    "permission.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiDAR depth comes through the camera. Frames are not saved to Photos and are not uploaded. You can allow the camera and deny location. Measuring while this app is on screen still works."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "光達深度是透過相機取得的。畫面不會存進相簿，也不會上傳。你可以只允許相機、拒絕定位。這個 App 在畫面上時，測距仍然可以運作。"
          }
        }
      }
    },
    "permission.openSettings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings to allow the camera"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到 iOS 設定打開相機"
          }
        }
      }
    },
    "permission.openPrivacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy and settings"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱私與設定"
          }
        }
      }
    },
    "unsupported.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone cannot measure distance ahead"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支 iPhone 量不到前方距離"
          }
        }
      }
    },
    "unsupported.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forward Radar needs an iPhone with LiDAR, such as 12 Pro, 13 Pro, and later Pro and Pro Max models. Phones without LiDAR stay on this screen. The app will not crash."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前方雷達需要有光達（LiDAR）的 iPhone，例如 12 Pro、13 Pro，以及之後的 Pro 與 Pro Max。沒有光達的機型會看到這個說明，App 不會閃退。"
          }
        }
      }
    },
    "unsupported.sceneDepth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scene depth"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "場景深度 sceneDepth"
          }
        }
      }
    },
    "unsupported.mesh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scene mesh"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "場景網格 mesh"
          }
        }
      }
    },
    "unsupported.yes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supported"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援"
          }
        }
      }
    },
    "unsupported.no": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not supported"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不支援"
          }
        }
      }
    },
    "unsupported.island": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island needs iPhone 14 Pro or later. Earlier Pro models still get sound, haptics, a Lock Screen Live Activity, and the large distance in the app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "動態島要 iPhone 14 Pro 或更新的機型。較早的 Pro 仍可用聲音、震動、鎖定畫面即時動態，以及 App 裡的大字距離。"
          }
        }
      }
    },
    "settings.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定"
          }
        }
      }
    },
    "settings.monitoring": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitoring"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "監測"
          }
        }
      }
    },
    "settings.lowPower": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low-power mode (15 times a second)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "省電模式（每秒 15 次）"
          }
        }
      }
    },
    "settings.sound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound alerts"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聲音警示"
          }
        }
      }
    },
    "settings.ignoreSilent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play even when muted"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使靜音也播放"
          }
        }
      }
    },
    "settings.haptics": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Haptic alerts"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "震動警示"
          }
        }
      }
    },
    "settings.preview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview the danger alert"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試播危險警示"
          }
        }
      }
    },
    "settings.monitoringFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Low Power Mode is on or the phone is hot, updates also drop to 15 times a second. A safe distance only shows green and stays quiet. Switching to another app or locking the phone pauses measuring, because iOS turns the camera off."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統低耗電或手機太熱時，也會自動降到每秒 15 次。安全距離只顯示綠色，不會一直響。切到別的 App 或鎖定手機時，測距會暫停，因為 iOS 會關掉相機。"
          }
        }
      }
    },
    "settings.island": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island and Lock Screen"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "動態島與鎖定畫面"
          }
        }
      }
    },
    "settings.restart": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart Live Activity"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新啟動動態島"
          }
        }
      }
    },
    "settings.islandFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it does not appear, open the Settings app and turn on Live Activities for Forward Radar. iPhones without Dynamic Island show it on the Lock Screen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若沒出現，到「設定」App 裡打開「前方雷達」的即時動態。沒有動態島的 iPhone 會顯示在鎖定畫面。"
          }
        }
      }
    },
    "settings.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱私"
          }
        }
      }
    },
    "settings.systemSettings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage camera and location in iOS Settings"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到 iOS 設定管理相機與定位"
          }
        }
      }
    },
    "settings.revoke": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke consent and erase data"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除同意與所有資料"
          }
        }
      }
    },
    "settings.privacyFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This ends the Live Activity, deletes consent and settings on this phone, and returns to the agreement. Nothing can be uploaded, because nothing is uploaded."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除會結束動態島、刪掉這支手機上的同意與開關，並回到同意畫面。沒有東西可以上傳，因為我們本來就不上傳。"
          }
        }
      }
    },
    "settings.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "settings.revokeTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke consent and erase data on this phone?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要清除同意與所有本機資料嗎？"
          }
        }
      }
    },
    "settings.revokeConfirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase and return to the agreement"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除並回到同意畫面"
          }
        }
      }
    },
    "settings.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "settings.revokeMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This ends the Live Activity and deletes consent and settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會結束即時動態，並刪除同意紀錄與設定。"
          }
        }
      }
    },
    "settings.versionFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）"
          }
        }
      }
    },
    "settings.pip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental floating window"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實驗：子母畫面"
          }
        }
      }
    },
    "settings.pipFooterUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you leave this app, a small card can stay on screen. This iPhone does not allow the camera to keep measuring in the background, so the card says Paused and Tap to return. It will not keep showing the last distance. The Dynamic Island says paused too. Haptics and sound stop unless a new depth frame actually arrives. A free Apple ID can install this. The special multitasking-camera entitlement is not included, and neither is the voip background mode."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離開這個 App 時，會試著把一張小卡片留在畫面上。這支 iPhone 不允許相機在背景繼續量距離，所以小窗會寫「已暫停」和「點一下回到 App」，不會把離開前的公尺數留著假裝還在更新。動態島也會顯示已暫停。震動和聲音會停，除非真的又收到新的深度畫面。免費 Apple ID 可以安裝。沒有加入 Apple 才核准得了的多工相機資格，也沒有加入 voip。"
          }
        }
      }
    },
    "settings.pipFooterSupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone reports that the camera can be used in the background. If new depth frames keep arriving after you leave, the window shows the live distance, color, and emoji, and haptics and sound continue. If frames stop, the window and the Dynamic Island say paused and do not keep the old distance."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支 iPhone 回報背景可以使用相機。離開之後如果還有新的深度畫面進來，小窗會顯示即時距離、顏色和表情，震動和聲音也會繼續。如果畫面停了，小窗和動態島都會改成已暫停，不會留著舊距離。"
          }
        }
      }
    },
    "pip.pausedTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已暫停"
          }
        }
      }
    },
    "pip.pausedHint": {
      "extractionState": "manual",
