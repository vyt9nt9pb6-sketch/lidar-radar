    "radar.pausedMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS turns the camera off when another app is in front, or when the phone locks. Return to this screen and measuring continues. LiDAR cannot keep running in the background."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切到別的 App，或手機鎖定時，iOS 會關掉相機。回到這個畫面就會自動繼續。光達沒辦法在背景繼續量。"
          }
        }
      }
    },
    "radar.failureTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiDAR needs a restart"
          }
