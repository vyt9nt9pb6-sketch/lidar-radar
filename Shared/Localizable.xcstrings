    "radar.aim": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point the back of the phone forward. Alerts sit in the Dynamic Island at the top of the screen. Without Dynamic Island, they appear on the Lock Screen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把手機背面朝向前方。警示在螢幕最上方的動態島；沒有動態島的話，會出現在鎖定畫面。"
          }
        }
      }
    },
    "radar.thresholds": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safe ≥ 1.5 m · Caution < 1.5 · Danger < 0.8. The screen stays awake while monitoring."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安全 ≥ 1.5 公尺 · 注意 < 1.5 · 危險 < 0.8。螢幕監測中不會自動鎖定。"
          }
        }
      }
    },
    "radar.principlesLine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processed on this iPhone · Never uploaded · Never stored"
